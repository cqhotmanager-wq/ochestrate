AGENT_APP_NAME=enterprise-agent-platform
AGENT_ENV=dev
AGENT_API_PREFIX=/v1
AGENT_MYSQL_DSN=mysql+pymysql://root:123456@127.0.0.1:3306/ochestrate
AGENT_MILVUS_URI=http://localhost:19530
AGENT_MODEL_ROUTING_PATH=config/model_routing.yaml
AGENT_TOOL_SECURITY_PATH=config/tool_security.yaml
AGENT_MAX_CONTEXT_TOKENS=4096
AGENT_SHORT_MEMORY_TURNS=12
AGENT_LONG_MEMORY_DEFAULT_TTL_DAYS=180
AGENT_SKILL_STORAGE_DIR=config/skills
AGENT_SKILL_SCAN_DIRS=["config/skills"]
AGENT_SKILL_SCAN_GLOB=**/SKILL.md
AGENT_PROMPT_SKILL_MAX_ITEMS=100
AGENT_AUDIT_LOG_PATH=logs/audit.log
AGENT_WORKER_POLL_INTERVAL_SECONDS=0.2
AGENT_TASK_QUEUE_BACKEND=redis
AGENT_REDIS_URL=redis://localhost:6379/0
AGENT_REDIS_QUEUE_NAME=agent_tasks
AGENT_JWT_SECRET=replace-this-in-production
AGENT_JWT_ALGORITHM=HS256
AGENT_ACCESS_TOKEN_TTL_MINUTES=30
AGENT_REFRESH_TOKEN_TTL_DAYS=7
AGENT_AUTH_REQUIRE_ENABLED=true
AGENT_AUTH_BOOTSTRAP_ADMIN_ENABLED=true
AGENT_SKILL_CACHE_TTL_SECONDS=60
AGENT_RETRIEVAL_CACHE_TTL_SECONDS=30
